set NERDTree

" highlight search results
set hlsearch

" visible lines above/below cursor
set scrolloff=5

let mapleader = "\<SPACE>"

nnoremap <TAB> :tabnext<CR>

" clear the search buffer when hitting return
nnoremap <silent> <CR> :noh<CR>

nnoremap <leader>sf :action SearchEverywhere<CR>
nnoremap <leader>ss :action FindInPath<CR>
nnoremap <leader>r :action RenameElement<CR>
nnoremap <leader>f :action ReformatCode<CR>
nnoremap <leader>o :action OptimizeImports<CR>
nnoremap <leader>. :action ShowIntentionActions<CR>
vnoremap <leader>. :action ShowIntentionActions<CR>
nnoremap <leader>g :action GotoImplementation<CR>
nnoremap <leader>e :NERDTree<CR>
nnoremap <leader>t :action ActivateTerminalToolWindow<CR>
nnoremap <leader>i :action ParameterInfo<CR>
nnoremap <leader>d :action ShowErrorDescription<CR>
nnoremap <leader>ne :action GotoNextError<CR>
nnoremap <leader>pe :action GotoPreviousError<CR>
nnoremap <leader>b :action ToggleLineBreakpoint<CR>
nnoremap <leader>9 :action Debug<CR>
nnoremap <leader>0 :action Stop<CR>
nnoremap <leader>c :action CommentByLineComment<CR>
vnoremap <leader>c :action CommentByLineComment<CR>
nnoremap <leader>x :action HideAllWindows<CR>
nnoremap <leader>qt :tabonly<CR>
